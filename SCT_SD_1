Create a program that converts temperatures between Celsius, Fahrenheit, and Kelvin scales. 

def celsius_to_fahrenheit(c):
    return (c * 9/5) + 32

def celsius_to_kelvin(c):
    return c + 273.15

def fahrenheit_to_celsius(f):
    return (f - 32) * 5/9

def fahrenheit_to_kelvin(f):
    return (f - 32) * 5/9 + 273.15

def kelvin_to_celsius(k):
    return k - 273.15

def kelvin_to_fahrenheit(k):
    return (k - 273.15) * 9/5 + 32

def convert_temperature(value, scale):
    scale = scale.lower()
    if scale == "c":
        print(f"{value} °C = {celsius_to_fahrenheit(value):.2f} °F | {celsius_to_kelvin(value):.2f} K")
    elif scale == "f":
        print(f"{value} °F = {fahrenheit_to_celsius(value):.2f} °C | {fahrenheit_to_kelvin(value):.2f} K")
    elif scale == "k":
        print(f"{value} K = {kelvin_to_celsius(value):.2f} °C | {kelvin_to_fahrenheit(value):.2f} °F")
    else:
        print("Invalid scale! Use 'C' for Celsius, 'F' for Fahrenheit, or 'K' for Kelvin.")

# Example usage:
convert_temperature(100, "C")
convert_temperature(32, "F")
convert_temperature(300, "K")
